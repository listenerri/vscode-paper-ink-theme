      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8f6f23"
      }
    },
    {
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#aa3606"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#c13c3b"
      }
    },
    {
