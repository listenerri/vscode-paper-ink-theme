  "tokenColors": [
    {
      "settings": {
        "foreground": "#30231b"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#635147",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#3e7050"
      }
    },
    {
      "scope": [
        "string.regexp",
        "string.interpolated"
      ],
      "settings": {
        "foreground": "#3e7050"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#8f6f23"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "storage.unit",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#aa3606"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#4d6291"
      }
    },
    {
      "scope": [
        "entity.name.type",
